{
  "name": "aof-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p .",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "indexer": "ts-node services/indexer/priceTracker.ts",
    "trust-worker": "ts-node services/trust-worker/index.ts",
    "farm-trader": "ts-node services/farm-trader/index.ts",
    "workers:all": "npm run indexer & npm run trust-worker & npm run farm-trader",
    "price-cranker": "ts-node services/price-cranker/index.ts",
    "push-worker": "ts-node services/push-worker/index.ts",
    "commit-expirer": "ts-node services/commit-expirer/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url file:./.migrate-shadow.db --exit-code",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:postgres:gen": "python3 scripts/gen-postgres-schema.py",
    "prisma:postgres:check": "python3 scripts/gen-postgres-schema.py --check",
    "prisma:postgres:migrate:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "test:wallet-proof": "ts-node --project tsconfig.json --transpile-only scripts/walletProofSelfTest.ts",
    "test:wallet-proof-middleware": "ts-node --project tsconfig.json --transpile-only scripts/walletProofMiddlewareTest.ts",
    "test:authority-gate": "ts-node --project tsconfig.json --transpile-only scripts/authorityGateSelfTest.ts",
    "test:resource-registry": "ts-node --project tsconfig.json --transpile-only scripts/resourceRegistrySelfTest.ts",
    "test:security-invariants": "ts-node --project tsconfig.json --transpile-only scripts/securityInvariantSelfTest.ts",
    "test:session-keystore": "ts-node --project tsconfig.json --transpile-only scripts/sessionKeystoreSelfTest.ts",
    "test:fraud-hold": "ts-node --project tsconfig.json --transpile-only scripts/fraudHoldSelfTest.ts",
    "test:idempotency-db": "NODE_PATH=$PWD/node_modules ts-node --project tsconfig.json --transpile-only scripts/idempotencyIntegrationTest.ts",
    "test:idempotency-db:pg": "prisma generate --schema prisma/postgres/schema.prisma && NODE_PATH=$PWD/node_modules ts-node --project tsconfig.json --transpile-only scripts/idempotencyIntegrationTest.ts",
    "test:audit-security": "ts-node --project tsconfig.json --transpile-only scripts/auditSecuritySelfTest.ts",
    "test:admin-auth": "ts-node --project tsconfig.json --transpile-only scripts/adminAuthSelfTest.ts",
    "test:fraud-signals": "ts-node --project tsconfig.json --transpile-only scripts/fraudSignalsSelfTest.ts",
    "test:watchtower": "cd ../watchtower && npm test",
    "test:chain-indexer": "ts-node --project tsconfig.json --transpile-only scripts/chainIndexerSelfTest.ts",
    "chain-indexer": "ts-node services/chain-indexer/index.ts",
    "caps:init": "ts-node --project tsconfig.json --transpile-only scripts/initIssuanceCaps.ts",
    "reconcile:inbox": "ts-node --project tsconfig.json scripts/reconcileInboxClaims.ts",
    "build:workers": "tsc -p tsconfig.workers.json",
    "build:watchtower": "tsc -p ../watchtower/tsconfig.json --outDir ../watchtower/dist",
    "test:reward-receipts": "ts-node --project tsconfig.json --transpile-only scripts/rewardReceiptSelfTest.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.75.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "1.98.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@coral-xyz/anchor": {
      "toml": "4.2.0"
    }
  }
}
